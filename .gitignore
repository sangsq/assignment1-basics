# Byte-compiled files and tool caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Packaging and build output
build/
dist/
*.egg-info/
*.egg

# Environments
.env
.venv/
venv/

# Editors and agents
.vscode/
.claude/

# Coverage
.coverage
coverage.xml
htmlcov/

# Corpora and encoded token arrays. Multi-GB and reproducible from scripts/,
# so they live outside the repo; point ./data at them with a symlink.
data/
*.gz
*.zip

# Trained tokenizers, checkpoints and any other model binary. All of it is
# reproduced by scripts/, so none of it belongs in git. The negations keep the
# course-provided test fixtures and snapshots tracked.
tokenizers/
checkpoints/
*.pt
*.pth
*.npy
!tests/fixtures/**
!tests/_snapshots/**

# Run outputs
logs/
runs/
wandb/
*.log
test_results.xml
